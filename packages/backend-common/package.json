{
  "name": "@platform/backend-common",
  "version": "0.1.0",
  "private": true,
  "description": "Closed backend module shared by all services: Express service bootstrap, error envelope, logging, config, local JSON storage and the ledger / KYC vendor / feature-flag connectors. Must never import from services/* or apps/*.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@platform/shared-types": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
