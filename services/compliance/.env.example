# Port this BFF listens on.
PORT=4000
# Comma-separated browser origins allowed to call this BFF (its paired app only).
APP_ORIGINS=http://localhost:3000
# Interface to bind (default 127.0.0.1, loopback only). BFFs have no auth yet — don't expose them.
# HOST=127.0.0.1
# Connector JSON files (seeded on first boot). Default: packages/backend-common/data
# PLATFORM_CONNECTOR_DATA_DIR=
# Simulated connector latency in ms: range "50-150" (default), fixed "80", or "off".
# PLATFORM_SIMULATED_LATENCY_MS=50-150
