{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "PLATFORM_DATA_DIR",
    "PLATFORM_STORAGE",
    "PLATFORM_SIMULATED_LATENCY_MS"
  ],
  "tasks": {
    "//#lint:boundaries": {
      "cache": false
    },
    "lint": {
      "dependsOn": [
        "//#lint:boundaries",
        "typecheck"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
